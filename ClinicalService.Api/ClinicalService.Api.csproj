<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<!-- Same id as ClinicalGrpcService.Grpc, so both share one secrets.json locally -->
		<UserSecretsId>3b74209d-ec6c-48fe-8525-8137f01b99fe</UserSecretsId>
		<DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Azure.Extensions.AspNetCore.Configuration.Secrets" Version="1.5.2" />
		<PackageReference Include="Azure.Identity" Version="1.21.0" />
		<PackageReference Include="FluentValidation" Version="12.2.0" />
		<PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.2.0" />
		<PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\ClinicalGrpcService.Application\ClinicalGrpcService.Application.csproj" />
		<ProjectReference Include="..\ClinicalGrpcService.ServiceDefaults\ClinicalGrpcService.ServiceDefaults.csproj" />
	</ItemGroup>

</Project>